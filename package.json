{
  "name": "smart-audit-pipeline",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --config vite.config.ts\"",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build --config vite.config.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/modules/audit/services/AuditMutationPolicy.test.js dist-test/modules/audit/services/AIWorkerService.test.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
